# Supabase - obtén estos valores en https://supabase.com/dashboard → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://jlwxbxuwcamvsqihdyiv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clave service_role (secreta) para crear usuarios directamente en el panel de administrador
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_secret_aqui

# Configuración de Envío de Correos (Gmail SMTP con Nodemailer)
# 1. Ve a tu cuenta de Google (myaccount.google.com)
# 2. Seguridad -> Verificación en 2 pasos (debe estar activada)
# 3. Al final, busca "Contraseñas de aplicaciones" (App Passwords)
# 4. Crea una contraseña (ej. Nombre: "Efrendrums Web") y copia el código de 16 caracteres
SMTP_USER=efrendeveloper1@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_aqui
ADMIN_EMAIL=efrendeveloper1@gmail.com
CAPTCHA_SECRET=tu_clave_secreta_para_captcha
